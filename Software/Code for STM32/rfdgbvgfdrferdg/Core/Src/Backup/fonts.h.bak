#ifndef __FONT_H
#define __FONT_H

#include "stdint.h"

typedef struct {
    const uint8_t width;
    uint8_t height;
    const uint16_t *data;
} FontDef;

typedef struct {
	uint8_t width;
	uint8_t height;
	uint32_t *data;
} FontDefMedium;

//Font lib.
// extern FontDef Font_7x10;
extern FontDef Font_11x18;
extern FontDef Font_16x28;
extern FontDef FontMorgan_16x36;
extern FontDefMedium FontMorgan_32x72;
#endif
